{
  "_comment": "Local L1 database -> CReM variants -> 3D -> align -> PDBQT -> Vina -> ranking. Paths use ${ISOGROW_DATA}; relative paths are resolved against the working directory.",
  "name": "example_local",
  "source": "local",
  "query": "[*:1]c1cc2ccccc2o1",
  "mmpdb_path": "${ISOGROW_DATA}/mmpdb/chembl.mmpdb",
  "logp_range": [-10, 10],
  "tpsa_range": [-300, 300],
  "mw_range": [-200, 80],
  "max_candidates": 5,
  "variants_per_candidate": 6,
  "crem_db": "${ISOGROW_DATA}/crem/chembl.db",
  "crem": {
    "radius": 2,
    "min_size": 0,
    "max_size": 0,
    "min_inc": -2,
    "max_inc": 2,
    "replace_cycles": false,
    "max_replacements": 20,
    "protect_H": true
  },
  "ref_ligand": "tests/data/reference_ligand.sdf",
  "receptor": "tests/data/receptor.pdbqt",
  "box_padding": 8.0,
  "docking_backend": "vina",
  "dock": {
    "exhaustiveness": 4,
    "cpu": 4
  },
  "out": "runs/example_local"
}
